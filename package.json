{
  "name": "function-scope-line",
  "displayName": "代码范围线",
  "description": "光标移到任意代码块（函数、类、结构体等）名称上，左侧就显示完整范围垂线；支持一键选中整个代码块",
  "version": "1.0.5",
  "icon": "icon.png",
  "publisher": "405050277",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "keywords": ["scope", "function", "class", "struct", "block", "highlight", "range", "bracket", "guide", "line"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/405050277/function-scope-line.git"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "代码范围线",
      "properties": {
        "functionScopeLine.color": {
          "type": "string",
          "default": "",
          "description": "范围线颜色，支持 CSS 颜色值如 #FF8C00、rgba(255,140,0,0.8)。留空则使用主题默认括号高亮颜色。"
        },
        "functionScopeLine.lineWidth": {
          "type": "number",
          "default": 1.5,
          "description": "范围线宽度（像素）"
        }
      }
    },
    "commands": [
      {
        "command": "functionRange.select",
        "title": "选中整个代码块"
      }
    ],
    "keybindings": [
      {
        "command": "functionRange.select",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "tsc -p ./ && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
